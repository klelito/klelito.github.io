{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-translations.mjs && node scripts/check-cv.mjs && node scripts/check-confidential.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.*\"",
    "test:e2e": "playwright test",
    "ci": "npm run check && npm run test:unit && npm run build && npm run test:e2e",
    "og": "node scripts/make-og.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
