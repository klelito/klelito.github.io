---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, switchLocalePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
}

const { locale, title, description, path } = Astro.props;
const absolute = (p: string) => new URL(p, SITE.url).href;
const canonical = absolute(path);
const ogImage = absolute(`/og-${locale}.png`);
const OG_LOCALE: Record<Locale, string> = { pl: 'pl_PL', en: 'en_US' };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07080a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={absolute(switchLocalePath(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(switchLocalePath(path, 'pl'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale).skip}</a>
    <Nav locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} path={path} />
  </body>
</html>
