---
// GitHub Pages serves this file for every unknown URL, so it speaks both languages.
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePath } from '../i18n/routes';
import { t } from '../i18n/ui';

const pl = t('pl');
const en = t('en');
---

<BaseLayout locale="pl" title={`${pl['notFound.title']} — ${pl['meta.homeTitle']}`} description={pl['meta.homeDescription']} path="/404/">
  <section class="container not-found">
    <p class="code mono" aria-hidden="true">404</p>
    <h1 class="section-title">{pl['notFound.title']}</h1>
    <p class="muted" lang="en">{en['notFound.title']}</p>
    <div class="actions">
      <a class="btn-key" href={homePath('pl')}>{pl['notFound.back']}</a>
      <a class="btn-ghost" href={homePath('en')} hreflang="en" lang="en">{en['notFound.back']}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block: calc(var(--header-offset) + var(--space-24)) var(--space-32);
    text-align: center;
  }

  .code {
    background: var(--gradient-warm-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 4rem;
    font-weight: 500;
    line-height: 1;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
</style>
