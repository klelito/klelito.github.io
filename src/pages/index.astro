---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';

const locale = 'pl';
const s = t(locale);
---

<BaseLayout locale={locale} title={s['meta.homeTitle']} description={s['meta.homeDescription']} path="/">
  <section class="container section">
    <h1>{s['meta.homeTitle']}</h1>
  </section>
</BaseLayout>
