---
import ProjectGlyph from './ProjectGlyph.astro';
import { projectPath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Project } from '../lib/content';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const s = t(locale);
const { data } = project;
const repo = data.kind === 'own' ? data.links?.repo : undefined;
const demo = data.kind === 'own' ? data.links?.demo : undefined;
---

<article class="project-card glass">
  <ProjectGlyph variant={data.order - 1} />
  <span class="chip kind">{data.kind === 'company' ? s['kind.company'] : s['kind.own']}</span>
  <h3 class="title">{data.title}</h3>
  <p class="summary">{data.summary}</p>
  <p class="metric">
    <span class="metric-value">{data.metric.value}</span>
    <span class="metric-label mono">{data.metric.label}</span>
  </p>
  <ul class="stack" role="list">
    {
      data.stack.map((tech) => (
        <li class="chip">{tech}</li>
      ))
    }
  </ul>
  <div class="links">
    <a class="link-arrow" href={projectPath(locale, project.slug)}>
      {s['projects.read']}<span class="sr-only">: {data.title}</span>
      <span aria-hidden="true">→</span>
    </a>
    {
      repo && (
        <a class="link-arrow" href={repo}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3" />
          </svg>
          {s['projects.code']}<span class="sr-only">: {data.title}</span>
        </a>
      )
    }
    {
      demo && (
        <a class="link-arrow" href={demo}>
          {s['projects.demo']}<span class="sr-only">: {data.title}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    transition:
      transform var(--duration-base) ease-out,
      box-shadow var(--duration-base) ease-out,
      border-color var(--duration-base) ease-out;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-warm-border);
    box-shadow: var(--shadow-card-hover);
  }

  .kind {
    align-self: flex-start;
    margin-bottom: var(--space-3);
  }

  .title {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .summary {
    flex: 1;
    margin-bottom: var(--space-5);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .metric {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-5);
  }

  .metric-value {
    font-size: var(--text-metric);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .metric-label {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-5);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .project-card:hover .links > a:first-child {
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }
</style>
