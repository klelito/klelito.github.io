---
import type { Locale } from '../i18n/routes';
import type { Highlight } from '../lib/content';

interface Props {
  locale: Locale;
  highlights: Highlight[];
}

const { locale, highlights } = Astro.props;
---

<div class="container metrics-wrap">
  <ul class="metrics" role="list">
    {
      highlights.map((h) => (
        <li class="metric">
          <span class="metric-value">{h.value}</span>
          <span class="metric-label mono">{h.label[locale]}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .metrics-wrap {
    position: relative;
    z-index: 1;
    padding-block: var(--space-16);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-fill-faint);
  }

  .metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }

  /* hairline grid: right border on the left column, bottom border on the first row */
  .metric:nth-child(odd) {
    border-right: 1px solid var(--color-hairline);
  }

  .metric:nth-child(-n + 2) {
    border-bottom: 1px solid var(--color-hairline);
  }

  .metric-value {
    font-size: var(--text-metric);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .metric-label {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .metrics {
      grid-template-columns: repeat(4, 1fr);
    }

    .metric:nth-child(-n + 2) {
      border-bottom: 0;
    }

    .metric:not(:last-child) {
      border-right: 1px solid var(--color-hairline);
    }

    .metric-value {
      font-size: 2.25rem;
    }
  }
</style>
