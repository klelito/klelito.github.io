---
import type { Locale } from '../i18n/routes';
import type { CollaborationItem } from '../lib/content';

interface Props {
  locale: Locale;
  steps: CollaborationItem[];
}

const { locale, steps } = Astro.props;
---

<ol class="steps" role="list">
  {
    steps.map((step, i) => (
      <li class="step">
        <span class="step-number mono">{String(i + 1).padStart(2, '0')}</span>
        <h3>{step.title[locale]}</h3>
        <p>{step.text[locale]}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    position: relative;
    display: grid;
    gap: var(--space-6);
    margin: 0;
  }

  .step {
    position: relative;
    display: grid;
    gap: var(--space-1);
  }

  .step-number {
    justify-self: start;
    margin-bottom: var(--space-2);
    padding-right: var(--space-2);
    background: var(--color-canvas);
    color: var(--color-coral);
    font-size: var(--text-sm);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  p {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }

    /* hairline connecting the step numbers */
    .steps::before {
      content: '';
      position: absolute;
      top: 0.7rem;
      right: 0;
      left: 0;
      height: 1px;
      background: var(--color-hairline);
    }

    .step-number {
      position: relative;
    }
  }
</style>
