---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<div class="contact-card glass">
  <div class="mail-row">
    <a class="mail mono" href={`mailto:${SITE.email}`}>
      <Icon name="mail" />
      {SITE.email}
    </a>
    <button class="chip copy" type="button" hidden data-copy-email={SITE.email} data-copied-label={s['contact.copied']}>
      {s['contact.copy']}
    </button>
    <span class="sr-only" role="status" data-copy-status></span>
  </div>

  <ul class="profiles" role="list">
    <li>
      <a class="link-arrow" href={SITE.linkedin}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path>
        </svg>
        LinkedIn
      </a>
    </li>
    <li>
      <a class="link-arrow" href={SITE.github}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path>
        </svg>
        GitHub
      </a>
    </li>
  </ul>

  {
    SITE.cv && (
      <div class="cvs">
        <a class="btn-key" href={SITE.cv.pl} download hreflang="pl">
          {s['contact.cvPl']}
        </a>
        <a class="btn-key" href={SITE.cv.en} download hreflang="en">
          {s['contact.cvEn']}
        </a>
      </div>
    )
  }
</div>

<script>
  import '../scripts/copy-email';
</script>

<style>
  .contact-card {
    display: grid;
    gap: var(--space-6);
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-8);
  }

  .mail-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-hairline);
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    font-size: var(--text-lg);
  }

  .mail :global(svg) {
    flex: none;
    color: var(--color-coral);
  }

  .copy {
    background: transparent;
    cursor: pointer;
    transition: color var(--duration-base) ease-out;
  }

  .copy:hover {
    color: var(--color-text);
  }

  .copy[hidden] {
    display: none;
  }

  .profiles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: 0;
  }

  .cvs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
