---
import { homePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section class="container cta-band" aria-labelledby="cta-band-title">
  <div class="cta-inner glass">
    <h2 id="cta-band-title" class="section-title">{s['case.ctaTitle']}</h2>
    <div class="cta-actions">
      <a class="btn-key" href={`${homePath(locale)}#kontakt`}>{s['cta.talk']}</a>
      <a class="btn-ghost" href={SITE.cv[locale]} download>{s['cta.cv']}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-bottom: var(--space-24);
  }

  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-10) var(--space-8);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
