---
// Decorative abstract diagram at the top of a project card (from the Aurora drafts). Never a real screenshot.
interface Props {
  variant: number;
}

const variant = Astro.props.variant % 4;
---

<div class="glyph" aria-hidden="true">
  <svg width="200" height="80" viewBox="0 0 200 80" fill="none">
    {
      variant === 0 && (
        <>
          <rect x="10" y="20" width="40" height="40" rx="4" stroke="rgba(255,255,255,0.15)" />
          <rect x="16" y="28" width="28" height="3" rx="1" fill="rgba(255,179,71,0.5)" />
          <rect x="16" y="36" width="20" height="3" rx="1" fill="rgba(255,255,255,0.12)" />
          <rect x="16" y="44" width="24" height="3" rx="1" fill="rgba(255,255,255,0.12)" />
          <path d="M55 40H75" stroke="rgba(255,107,74,0.6)" stroke-width="1.5" stroke-dasharray="3 2" />
          <path d="M75 36l7 4-7 4z" fill="rgba(255,107,74,0.6)" />
          <rect x="88" y="15" width="50" height="50" rx="6" stroke="rgba(255,107,74,0.4)" stroke-width="1.5" fill="rgba(255,47,58,0.06)" />
          <circle cx="113" cy="40" r="12" stroke="rgba(255,179,71,0.5)" />
          <path d="M107 40l4 4 10-10" stroke="#ffb347" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M143 40H163" stroke="rgba(255,107,74,0.6)" stroke-width="1.5" stroke-dasharray="3 2" />
          <path d="M163 36l7 4-7 4z" fill="rgba(255,107,74,0.6)" />
          <rect x="175" y="25" width="18" height="30" rx="3" stroke="rgba(255,255,255,0.15)" />
        </>
      )
    }
    {
      variant === 1 && (
        <>
          <rect x="20" y="12" width="70" height="56" rx="5" stroke="rgba(255,255,255,0.12)" />
          <rect x="20" y="12" width="70" height="14" rx="5" fill="rgba(255,107,74,0.1)" stroke="rgba(255,107,74,0.25)" />
          <circle cx="30" cy="19" r="2" fill="#ff2f3a" />
          <circle cx="38" cy="19" r="2" fill="#ffb347" />
          <rect x="28" y="34" width="40" height="3" rx="1" fill="rgba(255,255,255,0.12)" />
          <rect x="28" y="42" width="30" height="3" rx="1" fill="rgba(255,255,255,0.08)" />
          <rect x="110" y="12" width="70" height="56" rx="5" stroke="rgba(255,255,255,0.12)" />
          <rect x="118" y="22" width="24" height="18" rx="3" stroke="rgba(255,179,71,0.4)" fill="rgba(255,179,71,0.06)" />
          <rect x="148" y="22" width="24" height="18" rx="3" stroke="rgba(255,107,74,0.35)" fill="rgba(255,107,74,0.05)" />
          <rect x="118" y="48" width="54" height="10" rx="2" stroke="rgba(255,255,255,0.1)" />
          <path d="M90 40H110" stroke="rgba(255,107,74,0.4)" stroke-dasharray="2 2" />
        </>
      )
    }
    {
      variant === 2 && (
        <>
          <rect x="30" y="10" width="50" height="60" rx="6" stroke="rgba(255,255,255,0.15)" stroke-width="1.5" />
          <rect x="38" y="18" width="34" height="28" rx="2" stroke="rgba(255,179,71,0.4)" fill="rgba(255,179,71,0.05)" />
          <path d="M42 26H68" stroke="rgba(255,47,58,0.5)" stroke-width="1.5" />
          <path d="M42 32H62M42 38H65" stroke="rgba(255,255,255,0.15)" />
          <rect x="42" y="52" width="26" height="8" rx="2" stroke="rgba(255,107,74,0.4)" fill="rgba(255,107,74,0.08)" />
          <path d="M85 40H105" stroke="rgba(255,107,74,0.5)" stroke-width="1.5" stroke-dasharray="3 2" />
          <path d="M105 36l7 4-7 4z" fill="rgba(255,107,74,0.5)" />
          <rect x="118" y="22" width="55" height="36" rx="4" stroke="rgba(255,255,255,0.12)" />
          <rect x="126" y="30" width="16" height="3" rx="1" fill="rgba(255,179,71,0.4)" />
          <circle cx="158" cy="48" r="5" stroke="#ff6b4a" fill="rgba(255,47,58,0.1)" />
          <path d="M156 48l1.5 1.5L161 46" stroke="#ffb347" stroke-width="1.2" stroke-linecap="round" />
        </>
      )
    }
    {
      variant === 3 && (
        <>
          <rect x="25" y="15" width="150" height="50" rx="4" stroke="rgba(255,255,255,0.1)" />
          {[0.35, 0.25, 0.4, 0.06, 0.3, 0.2, 0.2].map((a, i) => (
            <rect x={40 + i * 18} y="25" width="14" height="14" rx="2" fill={`rgba(255,${i % 2 ? 107 : 179},${i % 2 ? 74 : 71},${a})`} />
          ))}
          {[0.3, 0.45, 0.06, 0.35, 0.5, 0.06, 0.2].map((a, i) => (
            <rect x={40 + i * 18} y="43" width="14" height="14" rx="2" fill={`rgba(255,${i % 2 ? 47 : 107},${i % 2 ? 58 : 74},${a})`} />
          ))}
        </>
      )
    }
  </svg>
</div>

<style>
  .glyph {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 7rem;
    margin-bottom: var(--space-5);
    overflow: hidden;
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-key);
    background: var(--color-fill-faint);
  }
</style>
