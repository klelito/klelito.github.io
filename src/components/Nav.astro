---
import LangSwitch from './LangSwitch.astro';
import { homePath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const s = t(locale);
const home = homePath(locale);
const links = [
  { href: `${home}#projekty`, label: s['nav.projects'] },
  { href: `${home}#doswiadczenie`, label: s['nav.experience'] },
  { href: `${home}#umiejetnosci`, label: s['nav.skills'] },
  { href: `${home}#wspolpraca`, label: s['nav.collaboration'] },
  { href: `${home}#kontakt`, label: s['nav.contact'] },
];
const cvShort = 'CV';
const cvPrefix = s['cta.cv'].replace(/\s*CV$/, '');
---

<header class="site-header">
  <nav class="nav-pill" aria-label={s.menu}>
    <a class="brand" href={home}>
      <svg class="brand-glyph" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <defs>
          <linearGradient id="brand-diamond" x1="0" y1="0" x2="14" y2="14" gradientUnits="userSpaceOnUse">
            <stop stop-color="var(--color-amber)"></stop>
            <stop offset="0.5" stop-color="var(--color-coral)"></stop>
            <stop offset="1" stop-color="var(--color-crimson)"></stop>
          </linearGradient>
        </defs>
        <path d="M7 1 13 7 7 13 1 7Z" fill="url(#brand-diamond)"></path>
      </svg>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <ul class="nav-links" role="list">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      <LangSwitch locale={locale} path={path} />
      <a class="cv-pill" href={SITE.cv[locale]} download>
        <span class="cv-prefix">{cvPrefix}{' '}</span>{cvShort}
      </a>
      <details class="nav-menu">
        <summary>{s.menu}</summary>
        <ul class="nav-menu-panel" role="list">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: var(--space-5) var(--space-4) 0;
    pointer-events: none;
  }

  .nav-pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    width: 100%;
    max-width: 56rem;
    padding: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-surface-strong);
    backdrop-filter: blur(24px);
    box-shadow: var(--shadow-pill);
    pointer-events: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .brand-glyph {
    flex: none;
  }

  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 2px;
    margin: 0 auto;
  }

  .nav-links a {
    display: block;
    padding: 0.375rem var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    transition: color var(--duration-base) ease-out;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }

  /* inline-block, not flex: flex items would drop the space between "Pobierz" and "CV" */
  .cv-pill {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    background: var(--color-key);
    color: var(--color-key-text);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
    transition: background var(--duration-base) ease-out;
  }

  .cv-pill:hover {
    background: var(--color-key-hover);
  }

  /* Below 768px the prefix ("Pobierz"/"Download") is read by screen readers only */
  .cv-prefix {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .nav-menu summary {
    padding: 0.375rem var(--space-3);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu[open] summary {
    color: var(--color-text);
    border-color: var(--color-hairline-hover);
  }

  .nav-menu-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    left: 0;
    display: grid;
    gap: 2px;
    padding: var(--space-2);
    border-radius: var(--radius-card);
    /* solid: a backdrop-filter nested inside the blurred pill does not blur in Chromium */
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-pill);
  }

  .nav-menu-panel a {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-key);
    color: var(--color-muted);
    font-size: var(--text-base);
  }

  .nav-menu-panel a:hover {
    background: var(--color-fill-subtle);
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .nav-pill {
      gap: var(--space-2);
      width: auto;
      padding-inline: var(--space-3) var(--space-2);
    }

    .brand {
      padding-inline: var(--space-2) var(--space-3);
    }

    .nav-actions {
      gap: var(--space-2);
    }

    .nav-links {
      display: flex;
    }

    .nav-menu {
      display: none;
    }

    .cv-prefix {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
  }
</style>
