---
import { projectPath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Project } from '../lib/content';

interface Props {
  locale: Locale;
  prev: Project;
  next: Project;
}

const { locale, prev, next } = Astro.props;
const s = t(locale);
---

<nav class="container prev-next" aria-label={s['case.more']}>
  <a class="pn-card glass" rel="prev" href={projectPath(locale, prev.slug)}>
    <span class="pn-dir mono"><span aria-hidden="true">← </span>{s['case.prev']}</span>
    <span class="pn-title overflow-safe">{prev.data.title}</span>
  </a>
  <a class="pn-card glass pn-next" rel="next" href={projectPath(locale, next.slug)}>
    <span class="pn-dir mono">{s['case.next']}<span aria-hidden="true"> →</span></span>
    <span class="pn-title overflow-safe">{next.data.title}</span>
  </a>
</nav>

<style>
  .prev-next {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .pn-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    transition:
      border-color var(--duration-base) ease-out,
      box-shadow var(--duration-base) ease-out;
  }

  .pn-card:hover {
    border-color: var(--color-warm-border);
    box-shadow: var(--shadow-card-hover);
  }

  .pn-dir {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .pn-title {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .prev-next {
      grid-template-columns: 1fr 1fr;
    }

    .pn-next {
      text-align: right;
    }
  }
</style>
